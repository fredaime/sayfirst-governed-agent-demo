# SPDX-License-Identifier: Apache-2.0
# Copy to .env and edit. NEVER commit .env — it is gitignored.
#
# The scripts that bootstrap, start, check, run and reset this demonstration read this file
# before they read a setting, and nothing inside the package reads it at all: the settings module
# resolves the environment and only the environment, so a script is where a file becomes an
# environment. A name already set in the environment is left alone, so a setting given on
# the command line always wins over the same name here; values containing a space are
# quoted; a line that is not NAME=value is refused with a sentence rather than run; and a
# name this file assigns twice is refused with the two lines named, because one file has
# one meaning.

# -- the control plane --------------------------------------------------------
# The address the daemon is listening at. `scripts/start-control-plane.sh` prints the one
# it bound; this is the same default, so a reader who used that script sets nothing here.
# SAYFIRST_SOCKET=/run/user/1000/sayfirst-demo/daemon.sock

# The scope every question is asked in. One scope, and there is no tenant: the control
# plane's axis is the scope, and `local` is its default.
SAYFIRST_SCOPE=local

# Who the agent is, as the boundary spells a person. Defaults to the account this process
# runs as, which is also what the daemon establishes from the connection's peer — it is
# never sent as a credential, and the policy file's rules name the same reference. The
# start script renders the policy with it, and admits a rendering-safe subset of what the
# control plane admits: `user:` and a lowercase letter or a digit, then up to 63 more of
# lowercase letters, digits, dots, underscores and dashes (the control plane itself accepts
# wider references; this script refuses them rather than render them unsafely).
# SAYFIRST_PRINCIPAL=user:you

# Where the start script puts the socket, the policy and the evidence, and what
# `scripts/reset-demo.sh` removes whole.
# SAYFIRST_DEMO_RUN=/run/user/1000/sayfirst-demo

# -- the model ----------------------------------------------------------------
# `fixture` is the default and needs nothing: the tests script the transcript themselves, so
# a reader who clones this and runs the gate gets a green run with no model at all, and no
# script forces a mode on a run. A take that wants to watch the agent reason opts in right
# here — `MODEL_MODE=real`, with `MODEL_BASE_URL` and `MODEL_NAME` — and a `real` run naming
# neither refuses at startup and says which two it wanted, because there is deliberately no
# fallback between the modes and no default address: a demonstration that quietly
# substituted a transcript would be showing governance over a model that was never there,
# and a default address would be a claim about your machine.
MODEL_MODE=fixture

# Any server that speaks the OpenAI-compatible API. With MODEL_MODE=real both of these are
# required, and a run that names neither says so and stops.
# MODEL_BASE_URL=http://127.0.0.1:11434/v1
# MODEL_NAME=a-tool-calling-model
# MODEL_API_KEY=
MODEL_TEMPERATURE=0
# What the terminal and the event stream call the model. Defaults to MODEL_NAME.
# MODEL_DISPLAY_NAME=

# -- runtime ------------------------------------------------------------------
# What a recording calls the agent. A display name and nothing more: who the agent IS is
# SAYFIRST_PRINCIPAL above, and nothing reads this one as an identity.
DEMO_AGENT_NAME="ResearchOps Agent"

DEMO_DATA=./demo_data
DEMO_OUTBOX=./runtime/outbox
DEMO_REPORTS=./runtime/reports
DEMO_EVENTS=./runtime/events
